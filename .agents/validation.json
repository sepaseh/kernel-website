{
  "schemaVersion": 1,
  "phase": "foundation",
  "applicationReady": false,
  "checks": [
    {
      "id": "snapshot",
      "command": "npm run check:snapshot",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "ci-policy",
      "command": "npm run check:ci",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "actions-lint",
      "command": "npm run check:actions",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "guidance",
      "command": "npm run check:guidance",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "audit",
      "command": "npm run audit",
      "kind": "required",
      "ciJobs": ["audit"],
      "scopes": ["foundation"]
    },
    {
      "id": "boundaries",
      "command": "npm run check:boundaries",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "lint",
      "command": "npm run lint",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "format",
      "command": "npm run format:check",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["foundation"]
    },
    {
      "id": "unit-coverage",
      "command": "npm run test:unit",
      "kind": "required",
      "ciJobs": ["unit"],
      "scopes": ["foundation"]
    },
    {
      "id": "governance-coverage",
      "command": "npm run test:governance",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["foundation"]
    },
    {
      "id": "font-integrity",
      "command": "npm run check:fonts",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["foundation"]
    }
  ],
  "profiles": {
    "full": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "guidance",
      "audit",
      "boundaries",
      "typecheck",
      "lint",
      "format",
      "unit-coverage",
      "governance-coverage",
      "font-integrity"
    ],
    "ci-quality": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "guidance",
      "boundaries",
      "typecheck",
      "lint",
      "format"
    ],
    "ci-audit": ["audit"],
    "ci-unit": ["unit-coverage"],
    "ci-governance": ["governance-coverage", "font-integrity"]
  },
  "externalWorkflows": [
    {
      "path": ".github/workflows/ci.yml",
      "mode": "ci"
    },
    {
      "path": ".github/workflows/codeql.yml",
      "mode": "security"
    }
  ]
}
