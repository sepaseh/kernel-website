{
  "schemaVersion": 1,
  "phase": "application",
  "applicationReady": true,
  "checks": [
    {
      "id": "snapshot",
      "command": "npm run check:snapshot",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "ci-policy",
      "command": "npm run check:ci",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "actions-lint",
      "command": "npm run check:actions",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "guidance",
      "command": "npm run check:guidance",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "audit",
      "command": "npm run audit",
      "kind": "required",
      "ciJobs": ["audit"],
      "scopes": ["application"]
    },
    {
      "id": "boundaries",
      "command": "npm run check:boundaries",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "lint",
      "command": "npm run lint",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "format",
      "command": "npm run format:check",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["application"]
    },
    {
      "id": "unit-coverage",
      "command": "npm run test:unit",
      "kind": "required",
      "ciJobs": ["unit"],
      "scopes": ["application"]
    },
    {
      "id": "governance-coverage",
      "command": "npm run test:governance",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["application"]
    },
    {
      "id": "font-integrity",
      "command": "npm run check:fonts",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["application"]
    },
    {
      "id": "dead-code",
      "command": "npm run check:unused",
      "kind": "required",
      "ciJobs": ["build"],
      "scopes": ["application"]
    },
    {
      "id": "build",
      "command": "npm run build",
      "kind": "required",
      "ciJobs": ["build", "e2e", "visual"],
      "scopes": ["application"]
    },
    {
      "id": "e2e",
      "command": "npm run test:e2e",
      "kind": "required",
      "ciJobs": ["e2e"],
      "scopes": ["application"]
    },
    {
      "id": "visual",
      "command": "npm run test:visual",
      "kind": "required",
      "ciJobs": ["visual"],
      "scopes": ["application"]
    }
  ],
  "profiles": {
    "full": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "guidance",
      "audit",
      "boundaries",
      "typecheck",
      "lint",
      "format",
      "unit-coverage",
      "governance-coverage",
      "font-integrity",
      "dead-code",
      "build",
      "e2e",
      "visual"
    ],
    "ci-quality": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "guidance",
      "boundaries",
      "typecheck",
      "lint",
      "format"
    ],
    "ci-audit": ["audit"],
    "ci-unit": ["unit-coverage"],
    "ci-governance": ["governance-coverage", "font-integrity"],
    "ci-build": ["dead-code", "build"],
    "ci-e2e": ["e2e"],
    "ci-visual": ["visual"]
  },
  "externalWorkflows": [
    {
      "path": ".github/workflows/ci.yml",
      "mode": "ci"
    },
    {
      "path": ".github/workflows/codeql.yml",
      "mode": "security"
    }
  ]
}
