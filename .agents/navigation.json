{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "governance-validation",
      "when": "Change the declared governance snapshot, boundaries, check agreement or assistant guidance.",
      "owners": [
        "scripts/check-boundaries.mjs",
        "scripts/check-ci.mjs",
        "scripts/check-guidance.mjs",
        "scripts/ci-evidence.mjs",
        "scripts/run-actionlint.mjs",
        "scripts/validate-bootstrap.mjs",
        "scripts/validate.mjs"
      ],
      "contracts": [
        ".agents/settings.json",
        ".agents/validation.json",
        ".github/bootstrap-policy.json",
        "CONTRIBUTING.md",
        "docs/validation.md"
      ],
      "tests": [
        "scripts/check-boundaries.test.mjs",
        "scripts/check-ci.test.mjs",
        "scripts/check-guidance.test.mjs",
        "scripts/ci-evidence.test.mjs",
        "scripts/run-actionlint.test.mjs",
        "scripts/validate-bootstrap.test.mjs",
        "scripts/validate.test.mjs",
        "scripts/validation.integration.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "actions-lint",
        "guidance",
        "boundaries",
        "lint",
        "format",
        "governance-coverage"
      ],
      "rules": [
        ".agents/rules/code-quality.md",
        ".agents/rules/guidance.md",
        ".agents/rules/testing.md"
      ]
    },
    {
      "id": "dependency-audit",
      "when": "Change audit execution or its observable failure and cancellation behavior.",
      "owners": ["scripts/run-audit.mjs"],
      "contracts": ["package-lock.json", "package.json", "vitest.config.ts"],
      "tests": ["scripts/run-audit.test.mjs"],
      "checks": ["audit", "lint", "unit-coverage"],
      "rules": [".agents/rules/code-quality.md", ".agents/rules/testing.md"]
    },
    {
      "id": "protected-review",
      "when": "Change native protected checks, current-head provider evidence and review policy.",
      "owners": ["scripts/check-ci.mjs"],
      "contracts": [
        ".coderabbit.yaml",
        "docs/branch-protection.md",
        "docs/reviews.md",
        "docs/sonarqube.md"
      ],
      "tests": ["scripts/check-ci.test.mjs"],
      "checks": ["ci-policy", "guidance", "lint", "governance-coverage"],
      "rules": [
        ".agents/rules/code-review.md",
        ".agents/rules/pull-requests.md",
        ".agents/rules/safety.md"
      ]
    },
    {
      "id": "shared-translation",
      "when": "Change flat root keys, explicit client key selections, ICU variables or locale registration.",
      "owners": [
        "src/i18n/catalog-data/locales.ts",
        "src/i18n/catalog-data/locales/ar.ts",
        "src/i18n/catalog-data/locales/de.ts",
        "src/i18n/catalog-data/locales/en.ts",
        "src/i18n/catalog-data/locales/es.ts",
        "src/i18n/catalog-data/locales/fa.ts",
        "src/i18n/catalog-data/locales/fr.ts",
        "src/i18n/catalog-data/locales/it.ts",
        "src/i18n/catalog-data/locales/pt.ts",
        "src/i18n/catalog-data/locales/ru.ts",
        "src/i18n/catalog-data/locales/tr.ts",
        "src/i18n/catalog-data/website-types.ts",
        "src/i18n/client-messages.ts"
      ],
      "contracts": [".agents/rules/localization.md", "docs/localization.md"],
      "tests": [
        "src/i18n/catalog-data/integrity.test.ts",
        "src/i18n/catalogs.test.ts",
        "src/i18n/client-messages.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "unit-coverage"],
      "rules": []
    }
  ]
}
