# Server-only upstream origin. The browser calls the website's /api proxy.
# Keep authentication secrets and database/storage credentials in the API app.
API_BASE_URL=http://localhost:3000

# Public website origin for canonical/share URLs, never the API origin.
WEBSITE_URL=http://localhost:3001
# Keep local, preview and staging sites out of search results.
WEBSITE_INDEXING_ENABLED=false
